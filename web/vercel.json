{
  "name": "dailyaitoll",
  "buildCommand": "node -e \"require('fs').writeFileSync('api/_build.json', JSON.stringify({built_at: new Date().toISOString(), commit: process.env.VERCEL_GIT_COMMIT_SHA || null}))\"",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/data/events.csv", "destination": "/api/data-download", "permanent": false },
    { "source": "/api/_data/:path*", "destination": "/api/data-download", "permanent": false }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/data-download.js": {
      "includeFiles": "api/_data/**"
    },
    "api/health.js": {
      "maxDuration": 10,
      "includeFiles": "api/_build.json"
    }
  }
}
